# Layer 2: the simulator (f1tenth_gym + gym_bridge) on top of the class base.
#
# `base` is a named build context: docker-compose.yml points it at the `base`
# service (docker/base.Dockerfile). Standalone:
#   docker build --build-context base=docker-image://ghcr.io/<owner>/f1tenth-base:<tag> .
#
# Students never work in this image: each week's exercise is its own small
# f1tenth-lab image (see ../class) on the same base, talking to this
# container over ROS 2 on a shared Docker network.

FROM base

SHELL ["/bin/bash", "-c"]
ENV DEBIAN_FRONTEND=noninteractive

# The container is the isolation layer, so f1tenth_gym is installed into the
# system Python rather than a venv: entry points generated by colcon use
# /usr/bin/python3, which would not see a venv-installed gym.
ENV PIP_BREAK_SYSTEM_PACKAGES=1

# CPU-only image: keep JAX on the CPU everywhere (the bridge pins itself too),
# which also silences the "NVIDIA GPU may be present" notice.
ENV JAX_PLATFORMS=cpu

# Debian-patched pip refuses to replace RECORD-less apt packages such as numpy.
# Install a fresh pip, then let the gym's dependency stack (NumPy 2, JAX, ...)
# land in /usr/local, which takes precedence over the apt copies.
RUN pip3 install --no-cache-dir --ignore-installed pip

# An editable install is required: the gym downloads tracks into its own maps/.
ARG GYM_REF=dev-jax
RUN git clone --depth 1 --branch ${GYM_REF} \
        https://github.com/f1tenth/f1tenth_gym.git /opt/f1tenth_gym && \
    pip3 install --no-cache-dir --ignore-installed -e /opt/f1tenth_gym

# Regular (non-symlink) install: the simulator is read-only for students.
COPY . /opt/sim_ws/src/f1tenth_gym_ros
RUN source /opt/ros/${ROS_DISTRO}/setup.bash && \
    apt-get update && \
    rosdep install -i --from-paths /opt/sim_ws/src --rosdistro ${ROS_DISTRO} -y && \
    rm -rf /var/lib/apt/lists/* && \
    cd /opt/sim_ws && colcon build && \
    rm -rf build log

COPY docker/entrypoint.sh /entrypoint.sh

# `docker exec` shells skip the entrypoint, so source the same things in .bashrc.
RUN echo 'source /opt/ros/${ROS_DISTRO}/setup.bash' >> /root/.bashrc && \
    echo 'source /opt/sim_ws/install/setup.bash' >> /root/.bashrc

WORKDIR /opt/sim_ws

# foxglove_bridge websocket (connect Foxglove to ws://localhost:8765)
EXPOSE 8765

ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
